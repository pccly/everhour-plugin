{
  "name": "everhour",
  "displayName": "Everhour",
  "version": "0.2.2",
  "description": "Log Everhour time against tracker tasks (Linear keys or Everhour ids) through MCP tools, a skill, and a CLI",
  "author": {
    "name": "Pho Huynh"
  },
  "repository": "https://github.com/pccly/everhour-plugin",
  "license": "MIT",
  "keywords": [
    "everhour",
    "time-tracking",
    "linear"
  ],
  "icon": "./assets/logo.svg",
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Everhour API token",
      "description": "Everhour > Settings > My Profile > Application Access. Leave empty to use the macOS Keychain item everhour-api-key.",
      "sensitive": true
    }
  },
  "mcpServers": {
    "everhour": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.mjs"
      ],
      "env": {
        "EVERHOUR_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "homepage": "https://github.com/pccly/everhour-plugin",
  "documentationUrl": "https://github.com/pccly/everhour-plugin#readme",
  "supportUrl": "https://github.com/pccly/everhour-plugin/issues",
  "privacyPolicyUrl": "https://github.com/pccly/everhour-plugin#privacy"
}
